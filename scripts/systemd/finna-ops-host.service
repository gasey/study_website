[Unit]
Description=Collect Finna host disk and paired-backup evidence
After=postgresql.service

[Service]
Type=oneshot
User=root
ExecStart=/srv/api/.venv/bin/python /srv/api/ops-collector.py host
RuntimeDirectory=finna-ops
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
UMask=0077
Nice=15
MemoryMax=256M
TimeoutStartSec=180
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/run/finna-ops
