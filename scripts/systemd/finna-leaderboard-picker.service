[Unit]
Description=Pre-pick Finna Daily Five & Weekly Cup leaderboard question sets
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=www-data
WorkingDirectory=/srv/api
EnvironmentFile=/etc/mpsc/db.env
Environment=DATABASE_URL=postgresql://mpsc@localhost:5432/mpsc
Environment=PYTHONUNBUFFERED=1
ExecStart=/srv/api/.venv/bin/python /srv/api/pick-leaderboard-questions.py --days-ahead 2 --theme balanced
TimeoutStartSec=3min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
